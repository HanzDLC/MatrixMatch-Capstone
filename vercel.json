{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api?__pathname=/"
    },
    {
      "source": "/:path*",
      "destination": "/api?__pathname=/:path*"
    }
  ]
}
